\documentclass[12pt,a4paper]{article}
\usepackage[top=1.1cm, bottom=1.1cm, left=1.3cm, right=1.3cm]{geometry}
\usepackage{amsmath, amssymb}
\usepackage{tabularx}
\usepackage{array}
\usepackage{graphicx}
\usepackage{listings}

\lstdefinestyle{code}{
  basicstyle=\ttfamily\scriptsize,
  frame=single,
  breaklines=true,
  columns=fullflexible,
  keepspaces=true,
  aboveskip=2.5pt,
  belowskip=2.5pt,
  xleftmargin=0.6em
}
\lstset{style=code}

\setlength{\parindent}{0pt}
\pagestyle{empty}

\begin{document}
\footnotesize

\IfFileExists{iit_logo.png}{%
\noindent
